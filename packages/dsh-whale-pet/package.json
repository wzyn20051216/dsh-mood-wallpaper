{
  "name": "dsh-whale-pet",
  "version": "0.2.0",
  "description": "DSH 自研多形象桌宠 v2：内置 5 个原创形象（鲸鱼/招财猫/企鹅/小幽灵/小恐龙）+ 自定义形象上传（自己的表情包/角色图/GIF 都能当桌宠）；可拖动、状态联动、点击互动。",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "pet",
    "whale",
    "mascot",
    "web-ui"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wzyn20051216/dsh-mood-wallpaper.git"
  },
  "bugs": {
    "url": "https://github.com/wzyn20051216/dsh-mood-wallpaper/issues"
  },
  "homepage": "https://github.com/wzyn20051216/dsh-mood-wallpaper/tree/master/packages/dsh-whale-pet",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-general"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.6"
  }
}
