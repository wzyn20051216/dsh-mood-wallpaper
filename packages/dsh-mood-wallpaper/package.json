{
  "name": "dsh-mood-wallpaper",
  "version": "0.8.1",
  "description": "DSH 壁纸感知动态壁纸引擎 v8.1（monorepo 版）：场景皮肤、玻璃材质、鲸鱼伙伴化、自定义文件夹壁纸、WebGL 着色器、后台分析、状态机 + 警报氛围 + token 速率驱动 + 极简模式（静默极简皮肤）。",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "assets",
    "cordis.patch.yml"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wzyn20051216/dsh-mood-wallpaper.git"
  },
  "bugs": {
    "url": "https://github.com/wzyn20051216/dsh-mood-wallpaper/issues"
  },
  "homepage": "https://github.com/wzyn20051216/dsh-mood-wallpaper/tree/master/packages/dsh-mood-wallpaper",
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "plugin",
    "wallpaper",
    "mood",
    "state-machine",
    "web-ui",
    "状态壁纸"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-general"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-locale": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-theme": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-settings-general": "^0.1.0-rc.6"
  }
}
