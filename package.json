{
  "name": "dsh-mood-wallpaper-all",
  "version": "0.8.0",
  "description": "DSH Wallpaper & HUD 全家桶聚合包：一条命令安装 dsh-mood-wallpaper（壁纸引擎）+ dsh-ui-hud（状态 HUD/记忆中心）两个插件。",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "wallpaper",
    "hud",
    "memory",
    "web-ui"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wzyn20051216/dsh-mood-wallpaper.git"
  },
  "bugs": {
    "url": "https://github.com/wzyn20051216/dsh-mood-wallpaper/issues"
  },
  "homepage": "https://github.com/wzyn20051216/dsh-mood-wallpaper#readme",
  "dependencies": {
    "dsh-mood-wallpaper": "file:packages/dsh-mood-wallpaper",
    "dsh-ui-hud": "file:packages/dsh-ui-hud"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
